#!/bin/zsh
# Ours; upstream's is kept pristine in Installer/scripts/ so merges never conflict.
# After each upstream merge, diff against it and port anything relevant by hand.

for driver in /Library/Audio/Plug-Ins/HAL/HOLOPHONIX\ Virtual\ Soundcard*ch.driver; do
    chown -R root:wheel "$driver"
    find "$driver" -type d -exec chmod 755 {} \;
    find "$driver" -type f -exec chmod 644 {} \;
    find "$driver/Contents/MacOS" -type f -exec chmod 755 {} \;
done
sleep 0.1
killall -9 coreaudiod || true
