#!/bin/zsh
#
# HOLOPHONIX Virtual Soundcard postinstall — used by create_holo_installer.zsh.
#
# Upstream's equivalent is kept pristine in Installer/scripts/ so that merges from
# BlackHole never conflict. The trade-off: upstream improvements no longer arrive
# here automatically. After each upstream merge, diff Installer/scripts/postinstall
# against this file and port anything relevant by hand.

sudo chown -R root:wheel /Library/Audio/Plug-Ins/HAL/HOLOPHONIX\ Virtual\ Soundcard*ch.driver
sleep 0.1
sudo killall -9 coreaudiod || true
